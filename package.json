{
  "name": "@capraconsulting/cals-cli",
  "version": "0.0.0-development",
  "description": "CLI for repeatable tasks in CALS",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "prepare": "husky",
    "build": "rollup -c && npm run build:types",
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir lib",
    "test": "vitest run --coverage src",
    "test:watch": "vitest --coverage src",
    "lint": "biome check",
    "lint:fix": "biome check --fix",
    "format": "biome format --write",
    "format:check": "biome format",
    "prepack": "./scripts/build-and-verify.sh",
    "semantic-release": "semantic-release",
    "watch": "rollup -c -w",
    "upgrade-deps": "ncu --upgrade --install=always --reject @types/node"
  },
  "main": "lib/index.js",
  "module": "lib/index.es.js",
  "types": "lib/index.d.ts",
  "bin": {
    "cals": "lib/cals-cli.mjs"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "cachedir": "^2.4.0",
    "chalk": "6.0.0",
    "execa": "^10.0.0",
    "find-up": "^8.0.0",
    "js-yaml": "^5.0.0",
    "keytar": "^7.9.0",
    "p-limit": "^7.3.0",
    "yargs": "18.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@octokit/types": "17.0.0",
    "@rollup/plugin-alias": "6.0.0",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-replace": "6.0.3",
    "@types/node": "24.13.3",
    "@types/yargs": "17.0.35",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "npm-check-updates": "23.0.2",
    "rollup": "4.62.5",
    "rollup-plugin-esbuild": "6.2.1",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "files": [
    "lib"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/capralifecycle/cals-cli.git"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
