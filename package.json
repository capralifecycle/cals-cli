{
  "name": "@capraconsulting/cals-cli",
  "version": "0.0.0-development",
  "description": "CLI for repeatable tasks in CALS",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "prepare": "husky",
    "build": "rollup -c && npm run build:types",
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir lib",
    "test": "mkdir -p coverage && node --import tsx --test --experimental-test-coverage --test-coverage-exclude='**/*.test.ts' --test-coverage-exclude=package.json --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info 'src/**/*.test.ts'",
    "test:watch": "node --import tsx --test --watch 'src/**/*.test.ts'",
    "lint": "biome check",
    "lint:fix": "biome check --fix",
    "format": "biome format --write",
    "format:check": "biome format",
    "prepack": "./scripts/build-and-verify.sh",
    "semantic-release": "semantic-release",
    "watch": "rollup -c -w",
    "upgrade-deps": "ncu --upgrade --install=always --reject @types/node"
  },
  "main": "lib/index.js",
  "module": "lib/index.es.js",
  "types": "lib/index.d.ts",
  "bin": {
    "cals": "lib/cals-cli.mjs"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "cachedir": "^2.4.0",
    "chalk": "6.0.1",
    "execa": "^10.0.0",
    "find-up": "^8.0.0",
    "js-yaml": "^5.0.0",
    "keytar": "^7.9.0",
    "p-limit": "^7.3.0",
    "yargs": "18.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@octokit/types": "18.0.0",
    "@rollup/plugin-alias": "6.0.1",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-replace": "6.0.3",
    "@types/node": "26.6.6",
    "@types/yargs": "17.0.35",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "npm-check-updates": "23.1.1",
    "rollup": "4.68.0",
    "rollup-plugin-esbuild": "6.2.1",
    "semantic-release": "25.0.9",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  },
  "files": [
    "lib"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/capralifecycle/cals-cli.git"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
